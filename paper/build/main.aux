\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Overview.} For every light, the Gaussians are rasterized once from the light; each deposits learned flux features $\boldsymbol  \phi _i$ and its depth moments with the compositing weight that equals the fraction of light it intercepts (\cref  {eq:atlas}). A receiver projects into the light, gathers multi-scale statistics and flux from the pyramid, and is shaded by a residual on the moment shadow test, transfer kernels applied linearly to the gathered flux features, and a local material. Thumbnails: actual buffers of our Hotdog model on a test view. Bottom: the schedule of \cref  {sec:optimization}.}}{4}{figure.caption.5}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pipeline}{{2}{4}{\textbf {Overview.} For every light, the Gaussians are rasterized once from the light; each deposits learned flux features $\boldsymbol \phi _i$ and its depth moments with the compositing weight that equals the fraction of light it intercepts (\cref {eq:atlas}). A receiver projects into the light, gathers multi-scale statistics and flux from the pyramid, and is shaded by a residual on the moment shadow test, transfer kernels applied linearly to the gathered flux features, and a local material. Thumbnails: actual buffers of our Hotdog model on a test view. Bottom: the schedule of \cref {sec:optimization}}{figure.caption.5}{}}
\newlabel{fig:pipeline@cref}{{[figure][2][]2}{[1][3][]4}{}{}{}}
