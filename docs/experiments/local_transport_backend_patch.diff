+// PORT-GS: expose the author's exact immutable EWA projection and tile order.
+#include "cuda_rasterizer/rasterizer_impl.h"
+std::vector<torch::Tensor> FragmentDataCUDA(torch::Tensor geom, torch::Tensor bins,
+    torch::Tensor tiles, int count, int rendered, int tile_count) {
+    char* g = reinterpret_cast<char*>(geom.data_ptr());
+    char* b = reinterpret_cast<char*>(bins.data_ptr());
+    char* t = reinterpret_cast<char*>(tiles.data_ptr());
+    auto gs = CudaRasterizer::GeometryState::fromChunk(g, count);
+    auto bs = CudaRasterizer::BinningState::fromChunk(b, rendered);
+    auto ts = CudaRasterizer::TileState<false>::fromChunk(t, tile_count);
+    auto f = geom.options().dtype(torch::kFloat32);
+    auto i = geom.options().dtype(torch::kInt32);
+    return {torch::from_blob(gs.means2D, {count, 2}, f).clone(),
+            torch::from_blob(gs.conic_opacity, {count, 4}, f).clone(),
+            torch::from_blob(ts.gaussian_ranges, {tile_count, 2}, i).clone(),
+            torch::from_blob(bs.point_list, {rendered}, i).clone()};
+}
